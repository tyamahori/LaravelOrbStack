includes:
  - ../vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
  level: max
  paths:
    - ../bootstrap/app.php
    - ../libConfig
    - ../packages
    - ../config
    - ../database
    - ../public
    - ../tests
  tmpDir: ../.tempCache/.stan
  # ECS bundles php-cs-fixer and PHP_CodeSniffer under its own vendor/, outside
  # the project autoloader; scan them so libConfig/ecs.php resolves its fixers.
  scanDirectories:
    - ../vendor/symplify/easy-coding-standard/vendor/friendsofphp/php-cs-fixer/src
    - ../vendor/symplify/easy-coding-standard/vendor/squizlabs/php_codesniffer/src
  strictRules:
    allRules: true
  checkBenevolentUnionTypes: true
  checkUninitializedProperties: true
  checkTooWideReturnTypesInProtectedAndPublicMethods: true
  checkMissingCallableSignature: true
  checkMissingOverrideMethodAttribute: true
  checkImplicitMixed: true
  reportPossiblyNonexistentGeneralArrayOffset: true
  reportPossiblyNonexistentConstantArrayOffset: true
  reportAnyTypeWideningInVarTag: true
  checkTooWideThrowTypesInProtectedAndPublicMethods: true
  checkTooWideParameterOutInProtectedAndPublicMethods: true
  checkDynamicProperties: true
  checkFunctionNameCase: true
  checkInternalClassCaseSensitivity: true
  reportMaybesInMethodSignatures: true
  reportMaybesInPropertyPhpDocTypes: true
  reportStaticMethodSignatures: true
  reportWrongPhpDocTypeInVarTag: true
  reportMagicMethods: true
  reportMagicProperties: true
  reportIgnoresWithoutComments: true
  reportUnmatchedIgnoredErrors: true
  polluteScopeWithLoopInitialAssignments: false
  polluteScopeWithAlwaysIterableForeach: false
  polluteScopeWithBlock: false
  rememberPossiblyImpureFunctionValues: false
  # AGENTS.md: business outcomes are Domain exceptions and callers must handle
  # them; programming errors and infrastructure failures just propagate. Only
  # the former are checked, so every one has to appear in @throws. JsonException
  # is the one exception to that rule: every json_encode/json_decode failure path
  # must be declared up to the entry point that decides what the caller sees.
  exceptions:
    implicitThrows: false
    checkedExceptionRegexes:
      - '#^LaravelOrbStack\\[^\\]+\\Domain\\#'
    checkedExceptionClasses:
      - JsonException
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
      tooWideImplicitThrowType: true
      throwTypeCovariance: true
  # Larastan
  checkOctaneCompatibility: true
  noUnnecessaryEnumerableToArrayCalls: true
  checkModelProperties: true
  checkModelMethodVisibility: true
  checkConfigTypes: true
  checkAuthCallsWhenInRequestScope: true
  parseModelCastsMethod: true
  checkUnusedViews: true
  checkMissingTranslations: true
  configDirectories:
    - ../config
  viewDirectories:
    - ../packages/Samples/Http/Web/View
  ignoreErrors:
    # config/*.php run before the container exists; env() and *_path() are the only way in.
    -
      identifier: laravelOrbStack.noGlobalHelper
      path: ../config/*
    # A test lets a Domain exception escape to assert it (expectException) or
    # to fail; PHPUnit is the handler, and @throws on test methods says nothing.
    -
      identifier: missingType.checkedException
      path: ../packages/*/Test/*

services:
  -
    class: LibConfig\PhpStan\NoFacadeRule
    tags: [phpstan.rules.rule]
  -
    class: LibConfig\PhpStan\NoGlobalHelperRule
    tags: [phpstan.rules.rule]
  -
    class: LibConfig\PhpStan\NoShorthandNullablePhpdocRule
    tags: [phpstan.rules.rule]
