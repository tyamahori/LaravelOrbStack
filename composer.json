{
    "name": "tyamahori/laravelorbstack",
    "type": "project",
    "description": "Laravel and OrbStack by tyamahori!!",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "8.5.*",
        "ext-pdo": "*",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "psr/clock": "^1.0",
        "symfony/clock": "^8.1.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.4",
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "carthage-software/mago": "^1.58.2",
        "deptrac/deptrac": "^4.7.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.13.0",
        "nunomaduro/collision": "^8.9.5",
        "php-standard-library/phpstan-extension": "^2.1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1.0",
        "phpunit/phpunit": "^13.4.3",
        "rector/rector": "^2.7.0",
        "roave/security-advisories": "dev-latest",
        "symplify/easy-coding-standard": "^13.3.8"
    },
    "autoload": {
        "psr-4": {
            "LaravelOrbStack\\": "packages/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibConfig\\PhpStan\\": "libConfig/PhpStan/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "schema": "PGPASSWORD=$DB_PASSWORD PGOPTIONS=\"-c search_path=$DB_SCHEMA\" psqldef -h $DB_HOST -p $DB_PORT -U $DB_USERNAME $DB_DATABASE --config-inline \"target_schema: $DB_SCHEMA\" --file database/schema.sql",
        "schema:apply": "@schema --apply --enable-drop",
        "schema:dry-run": "@schema --dry-run",
        "schema:export": "@schema --export",
        "ide-helper": [
            "@php artisan ide-helper:generate .tempCache/.ide_helper.php",
            "@php artisan ide-helper:models --nowrite --dir=./packages --dir=./app -F .tempCache/.model.php",
            "@php artisan ide-helper:meta -F .tempCache/.meta.php"
        ],
        "stanCheck": [
            "./vendor/bin/phpstan analyse -c ./libConfig/phpstan.neon"
        ],
        "ecsCheck": [
            "./vendor/bin/ecs check -c ./libConfig/ecs.php"
        ],
        "rectorCheck": [
            "./vendor/bin/rector process --dry-run -c ./libConfig/rector.php"
        ],
        "deptracCheck": [
            "./vendor/bin/deptrac --config-file=./libConfig/deptrac.yaml --no-progress --report-uncovered --fail-on-uncovered"
        ],
        "phpunit": [
            "@php -d xdebug.mode=develop,coverage ./vendor/bin/phpunit -c ./libConfig/phpunit.xml --coverage-text --only-summary-for-coverage-text"
        ],
        "magoCheck": [
            "./vendor/bin/mago --workspace . --config ./libConfig/mago.toml --php-version=\"$(php -r 'echo PHP_VERSION;')\" lint"
        ],
        "psrCheck": [
            "@composer validate --strict --no-check-publish",
            "@composer dump-autoload --optimize --strict-psr --no-scripts"
        ],
        "structureCheck": [
            "@php ./libConfig/structureCheck.php"
        ],
        "lintCheck": [
            "@psrCheck",
            "@structureCheck",
            "@rectorCheck",
            "@stanCheck",
            "@ecsCheck",
            "@deptracCheck",
            "@magoCheck"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "nextPhp": "8.6",
        "composerVersion": "2.10.3",
        "composerDigest": "sha256:da624c2c705d54e2f5a9bb77a5dc6c7d091711433ebefd7035672e84c2010fee",
        "phpApacheDigest": "sha256:5fec3fb1f0322c20a01c8af35a09a96f3a83aa369650b0fed161e91cb84056ed",
        "frankenphpDigest": "sha256:8a7a935deb33959200628497b8201423c8b777d513a62ac1b69a91c624afdb3d"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
