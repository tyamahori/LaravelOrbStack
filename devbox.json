{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "flyctl",
    "go-task@3.53.1",
    "php@8.5.11",
    "php85Extensions.redis@latest",
    "php85Extensions.xdebug@3.5.3"
  ],
  "env": {
    "DEVELOPER_DIR": "",
    "SDKROOT": ""
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "devbox install"
    ],
    "scripts": {
      "composer": "composer install"
    }
  }
}
