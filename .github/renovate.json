{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranchPatterns": [
        "main"
    ],
    "enabledManagers": [
        "composer",
        "dockerfile",
        "docker-compose",
        "devbox",
        "custom.regex",
        "github-actions"
    ],
    "extends": [
        "config:best-practices",
        "schedule:weekends",
        ":automergeAll",
        ":automergePr",
        ":automergeRequireAllStatusChecks"
    ],
    "dependencyDashboard": true,
    "timezone": "Asia/Tokyo",
    "rangeStrategy": "bump",
    "automergeStrategy": "squash",
    "assignAutomerge": true,
    "packageRules": [
        {
            "groupName": "PHP",
            "groupSlug": "php",
            "matchPackageNames": [
                "php"
            ],
            "matchUpdateTypes": [
                "minor",
                "major"
            ]
        },
        {
            "groupName": "Laravel",
            "groupSlug": "laravel",
            "matchManagers": [
                "composer"
            ],
            "matchPackageNames": [
                "laravel/framework"
            ]
        },
        {
            "groupName": "PHP libraries",
            "groupSlug": "php-libraries",
            "matchManagers": [
                "composer"
            ],
            "ignoreDeps": [
                "laravel/framework",
                "php"
            ]
        },
        {
            "groupName": "Devbox",
            "groupSlug": "devbox",
            "matchManagers": [
                "devbox"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ]
        },
        {
            "groupName": "Docker images",
            "groupSlug": "docker-images",
            "matchManagers": [
                "dockerfile",
                "docker-compose",
                "custom.regex"
            ],
            "matchFileNames": [
                "**/*.Dockerfile",
                "**/Dockerfile",
                "**/compose.yaml"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "digest",
                "pinDigest"
            ]
        },
        {
            "groupName": "GitHub Actions",
            "groupSlug": "github-actions",
            "matchManagers": [
                "github-actions"
            ]
        },
        {
            "description": "PHP base image tags follow require.php; Renovate only refreshes their digests",
            "matchDepNames": [
                "php-apache-image",
                "frankenphp-image"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "enabled": false
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.Dockerfile$/"
            ],
            "matchStrings": [
                "go install (?<depName>[^@]+)@(?<currentValue>v[0-9.]+)"
            ],
            "datasourceTemplate": "go",
            "versioningTemplate": "semver-coerced"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^composer\\.json$/"
            ],
            "matchStrings": [
                "\"composerVersion\": \"(?<currentValue>[0-9.]+)\",\\s*\"composerDigest\": \"(?<currentDigest>sha256:[a-f0-9]+)\""
            ],
            "depNameTemplate": "composer",
            "datasourceTemplate": "docker",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Digest of php:<require.php>-apache; the tag follows require.php, so only the digest is updated here",
            "managerFilePatterns": [
                "/^composer\\.json$/"
            ],
            "matchStringsStrategy": "combination",
            "matchStrings": [
                "\"php\": \"(?<phpMinor>[0-9]+\\.[0-9]+)\\.\\*\"",
                "\"phpApacheDigest\": \"(?<currentDigest>sha256:[a-f0-9]+)\""
            ],
            "depNameTemplate": "php-apache-image",
            "packageNameTemplate": "php",
            "currentValueTemplate": "{{{phpMinor}}}-apache",
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Digest of dunglas/frankenphp:php<require.php>-trixie; the tag follows require.php, so only the digest is updated here",
            "managerFilePatterns": [
                "/^composer\\.json$/"
            ],
            "matchStringsStrategy": "combination",
            "matchStrings": [
                "\"php\": \"(?<phpMinor>[0-9]+\\.[0-9]+)\\.\\*\"",
                "\"frankenphpDigest\": \"(?<currentDigest>sha256:[a-f0-9]+)\""
            ],
            "depNameTemplate": "frankenphp-image",
            "packageNameTemplate": "dunglas/frankenphp",
            "currentValueTemplate": "php{{{phpMinor}}}-trixie",
            "datasourceTemplate": "docker"
        }
    ]
}
