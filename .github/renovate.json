{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranchPatterns": [
        "main"
    ],
    "enabledManagers": [
        "composer",
        "dockerfile",
        "docker-compose",
        "devbox",
        "custom.regex",
        "github-actions",
        "npm"
    ],
    "extends": [
        "config:best-practices",
        "schedule:weekends",
        ":automergeAll",
        ":automergePr",
        ":automergeRequireAllStatusChecks"
    ],
    "dependencyDashboard": true,
    "timezone": "Asia/Tokyo",
    "rangeStrategy": "bump",
    "automergeStrategy": "squash",
    "assignAutomerge": true,
    "packageRules": [
        {
            "groupName": "PHP",
            "groupSlug": "php",
            "matchPackageNames": [
                "php"
            ],
            "matchUpdateTypes": [
                "minor",
                "major"
            ]
        },
        {
            "groupName": "Laravel",
            "groupSlug": "laravel",
            "matchManagers": [
                "composer"
            ],
            "matchPackageNames": [
                "laravel/framework"
            ]
        },
        {
            "groupName": "PHP libraries",
            "groupSlug": "php-libraries",
            "matchManagers": [
                "composer"
            ],
            "ignoreDeps": [
                "laravel/framework",
                "php"
            ]
        },
        {
            "groupName": "Devbox",
            "groupSlug": "devbox",
            "matchManagers": [
                "devbox"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ]
        },
        {
            "groupName": "Docker images",
            "groupSlug": "docker-images",
            "matchManagers": [
                "dockerfile",
                "docker-compose",
                "custom.regex"
            ],
            "matchFileNames": [
                "**/*.Dockerfile",
                "**/Dockerfile",
                "**/compose.yaml"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "digest",
                "pinDigest"
            ]
        },
        {
            "groupName": "GitHub Actions",
            "groupSlug": "github-actions",
            "matchManagers": [
                "github-actions"
            ]
        },
        {
            "description": "The php image's minor follows require.php in composer.json; Renovate only bumps its patch and digest",
            "matchManagers": [
                "dockerfile"
            ],
            "matchPackageNames": [
                "php"
            ],
            "matchUpdateTypes": [
                "major",
                "minor"
            ],
            "enabled": false
        },
        {
            "description": "dunglas/frankenphp tags are <FrankenPHP version>-php<PHP version>-trixie; keep the PHP minor, order by FrankenPHP version then PHP patch",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "dunglas/frankenphp"
            ],
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>php\\d+\\.\\d+)\\.(?<build>\\d+)-trixie$"
        },
        {
            "description": "config.composerVersion in composer.json and the composer image in the Dockerfiles must move together",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "composer"
            ],
            "groupName": "Composer",
            "groupSlug": "composer"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.Dockerfile$/"
            ],
            "matchStrings": [
                "go install (?<depName>[^@]+)@(?<currentValue>v[0-9.]+)"
            ],
            "datasourceTemplate": "go",
            "versioningTemplate": "semver-coerced"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^composer\\.json$/"
            ],
            "matchStrings": [
                "\"composerVersion\": \"(?<currentValue>[0-9.]+)\""
            ],
            "depNameTemplate": "composer",
            "datasourceTemplate": "docker",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "PHP extensions installed with PIE resolve through Packagist",
            "managerFilePatterns": [
                "/\\.Dockerfile$/"
            ],
            "matchStrings": [
                "pie install (?:--\\S+ )*(?<depName>[a-z0-9-]+/[a-z0-9-]+):(?<currentValue>[0-9.]+)"
            ],
            "datasourceTemplate": "packagist"
        }
    ]
}
