# 許可リスト方式。既定ですべて除外し、flyio ステージの `COPY .` と `.docker/` からの個別 COPY が要るものだけ戻す。
# local ステージはソースをバインドマウントするので、ビルドコンテキストを使わない。
*
!.docker/common/
!.docker/flyio/
!artisan
!bootstrap/app.php
# Laravel が書き込むディレクトリは、空の .gitignore で存在だけを持ち込む
!bootstrap/cache/.gitignore
!storage/**/.gitignore
!composer.json
!composer.lock
!config/
!database/seeders/
!packages/
packages/*/Test/
!public/
public/hot
public/storage
**/.DS_Store
